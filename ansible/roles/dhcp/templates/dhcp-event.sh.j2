#!/bin/bash

# DHCP event handler script
# Generated by Ansible

LOG_FILE="/var/log/dhcp-events.log"
INVENTORY_FILE="{{ dhcp_dynamic_inventory_file | default('/etc/ansible/hosts.d/dynamic_hosts') }}"
KNOWN_HOSTS_FILE="/etc/ssh/ssh_known_hosts"

# @TODO: integrate with our agent about geting role of node in clusters
function get_instance_role_from_agent() {
    return 0
}

# @TODO: integrate with our agent about notifying when node is starting into clusters
function notify_agent_node_has_been_starting() {
    return 0
}

# @TODO: integrate with our agent about notifying when node is started into clusters
function notify_agent_node_has_been_starting() {
    return 0
}

# @TODO: integrate with our agent about notifying when node is removed from clusters
function notify_agent_node_has_been_removed() {
    return 0
}

function log() {
    logger "$(date '+%Y-%m-%d %H:%M:%S') $1"
}

case "$1" in
    "commit")
        log "New lease: $2 ($3)"
        
        notify_agent_node_has_been_starting $2 $3

        # Add to dynamic inventory
        echo "$2 ansible_host=$3 instance_role=$(get_instance_role_from_agent $2 $3)" >> "$INVENTORY_FILE"
        
        # Wait for SSH to become available
        for i in {1..30}; do
            if ssh-keyscan -H "$3" >> "$KNOWN_HOSTS_FILE" 2>/dev/null; then
                log "SSH key collected for $2 ($3)"
                break
            fi
            sleep 2
        done

        notify_agent_node_has_been_started $2 $3
        ;;
        
    "release"|"expiry")
        notify_agent_node_has_been_removed $2 $3

        log "Removed lease: $2 ($3)"
        sed -i "/$2/d" "$INVENTORY_FILE"
        sed -i "/$3/d" "$KNOWN_HOSTS_FILE"
        ;;
esac