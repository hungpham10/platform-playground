upstream elasticsearch_ssl {
    {% for item in groups['elasticsearch-master'] %}
        {% set node_host = hostvars[item]['full_hostname'] 
                          if 'full_hostname' in hostvars[item] 
                          else hostvars[item]['ansible_host'] %}
        {% set node_port = hostvars[item]['es_http_port'] 
                          if 'es_http_port' in hostvars[item] 
                          else es_http_port|default(9200) %}

    server {{ node_host }}:{{ node_port }};
    {% endfor %}
    keepalive 15;
}

server {
    listen {{ nginx_port }};
    server_name {{ nginx_server_name }};
    
{% if nginx_outbound_ssl is defined %}
    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
{% else %}
    location / {
        proxy_pass https://elasticsearch_ssl;
        proxy_http_version 1.1;                   # Cần cho keep-alive
        proxy_set_header Connection "Keep-Alive";
        proxy_set_header Proxy-Connection "Keep-Alive";

        # Forward các header quan trọng
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout hợp lý cho ES (các query nặng có thể chạy lâu)
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Buffer lớn hơn nếu cần (tùy trường hợp)
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        # Security headers cơ bản
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
{% endif %}
}

{% if nginx_outbound_ssl is defined %}
server {
    listen {{ nginx_ssl_port }} ssl http2;
    server_name {{ nginx_server_name }};

    # SSL setup
    ssl_certificate {{ nginx_outbound_ssl.cert }};
    ssl_certificate_key {{ nginx_outbound_ssl.key }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass https://elasticsearch_ssl;
        proxy_http_version 1.1;                   # Cần cho keep-alive
        proxy_set_header Connection "Keep-Alive";
        proxy_set_header Proxy-Connection "Keep-Alive";

        # Forward các header quan trọng
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout hợp lý cho ES (các query nặng có thể chạy lâu)
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Buffer lớn hơn nếu cần (tùy trường hợp)
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        # Security headers cơ bản
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
{% endif %}
