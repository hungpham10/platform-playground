#!/bin/bash

# Patroni notification script
# Generated by Ansible

MAIL_TO="{{ patroni_notify_email }}"
MAIL_FROM="patroni@{{ ansible_fqdn }}"
SMTP_SERVER="{{ patroni_smtp_server }}"
HOSTNAME=$(hostname -f)

log() {
    logger -t patroni-notify "$1"
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> /var/log/patroni/notifications.log
}

send_email() {
    local subject="$1"
    local body="$2"
    
    echo "Subject: $subject
From: $MAIL_FROM
To: $MAIL_TO
Content-Type: text/plain; charset=utf-8

$body" | sendmail -t
}

case "$1" in
    on_start)
        log "Patroni starting on $HOSTNAME"
        send_email "[Patroni] Node $HOSTNAME starting" "Patroni is starting on node $HOSTNAME"
        ;;
    on_stop)
        log "Patroni stopping on $HOSTNAME"
        send_email "[Patroni] Node $HOSTNAME stopping" "Patroni is stopping on node $HOSTNAME"
        ;;
    on_restart)
        log "Patroni restarting on $HOSTNAME"
        send_email "[Patroni] Node $HOSTNAME restarting" "Patroni is restarting on node $HOSTNAME"
        ;;
    on_role_change)
        log "Role change on $HOSTNAME: $2 -> $3"
        send_email "[Patroni] Role change on $HOSTNAME" "Role changed from $2 to $3"
        ;;
    *)
        log "Unknown event: $1"
        ;;
esac