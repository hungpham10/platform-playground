[global]
repo1-path={{ pgbackrest_backup_path }}
repo1-retention-full={{ pgbackrest_retention_full }}

{% if bucket is defined %}
repo1-s3-bucket={{ bucket.name }}
repo1-s3-endpoint={{ bucket.endpoint }}
repo1-s3-region={{ bucket.region }}

{% if bucket.access_key is defined %}
repo1-s3-key={{ bucket.access_key }}
{% endif %}

{% if bucket.secret_key is defined %}
repo1-s3-key-secret={{ bucket.secret_key }}
{% endif %}
{% endif %}

log-path={{ pgbackrest_log_path }}
log-level-console=info
log-level-file=debug
start-fast=y
delta=y
repo1-retention-full=2

[{{ pgbackrest_stanza_name }}]
pg1-path={{ postgres_data_dir }}
pg1-socket-path=/var/run/postgresql

{% for host in groups['postgres-nodes'] %}
{% set idx = loop.index + 1 %}

{% if host != inventory_hostname %}
# Setup for node: {{ host }}
pg{{ idx }}-path={{ postgres_data_dir }}
pg{{ idx }}-host={{ hostvars[host]['ansible_host'] }}
pg{{ idx }}-host-user=postgres
{% endif %}
{% endfor %}
