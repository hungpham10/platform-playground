#!/bin/bash
set -euo pipefail

REPORT_TYPE="$1"
REPORT_DIR="{{ pg_analysis_report_dir }}/${REPORT_TYPE}"
DATE=$(date +%Y-%m-%d)
SUMMARY_FILE="${REPORT_DIR}/summary-${DATE}.txt"
HTML_REPORT="${REPORT_DIR}/report-${DATE}.html"

if [[ ! -f "$SUMMARY_FILE" || ! -f "$HTML_REPORT" ]]; then
  echo "Report files not found for ${DATE}"
  exit 1
fi

# Prepare email body
{
  echo "PostgreSQL ${REPORT_TYPE^} Analysis Report for ${DATE}"
  echo "=================================================="
  echo
  echo "Summary of findings:"
  cat "$SUMMARY_FILE"
  echo
  echo "Detailed HTML report is attached."
  echo
  echo "Access the full report at:"
  echo "http://{{ ansible_fqdn }}/postgres-reports/${REPORT_TYPE}/report-${DATE}.html"
} > /tmp/postgres-report-${DATE}.txt

# Send email with attachment
mail \
  -s "PostgreSQL ${REPORT_TYPE^} Report - ${DATE}" \
  -r "{{ pg_report_email_from }}" \
  -S smtp="{{ pg_report_smtp_server }}" \
  -a "$HTML_REPORT" \
  "{{ pg_report_email_to }}" < /tmp/postgres-report-${DATE}.txt

rm -f /tmp/postgres-report-${DATE}.txt