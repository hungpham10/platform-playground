
# Kafka KRaft configuration for node {{ inventory_hostname }}
# Generated by Ansible

# Vai trò của node
process.roles={{ kafka_process_roles | join(',') }}

# ID duy nhất cho node
node.id={{ kafka_node_id }}

# Quorum controllers
controller.quorum.voters={{ kafka_controller_quorum_voters | join(',') }}
controller.listener.names={{ kafka_controller_listener_names }}

# Cấu hình listeners dựa trên vai trò
{% if kafka_process_roles == 'controller' %}
listeners={{ kafka_listeners.controller }}
{% elif kafka_process_roles == 'broker' %}
listeners={{ kafka_listeners.broker }}
inter.broker.listener.name={{ kafka_inter_broker_listener_name }}
advertised.listeners={{ kafka_advertised_listeners }}
{% else %}
listeners={{ kafka_listeners.broker }},{{ kafka_listeners.controller }}
inter.broker.listener.name={{ kafka_inter_broker_listener_name }}
controller.listener.names={{ kafka_controller_listener_names }}
advertised.listeners={{ kafka_advertised_listeners }}
{% endif %}

# Thư mục lưu trữ log và metadata
log.dirs={{ data_dir }}

# Cấu hình topic
num.partitions={{ kafka_num_partitions }}
default.replication.factor={{ kafka_default_replication_factor }}
offsets.topic.replication.factor={{ kafka_offsets_topic_replication_factor }}
transaction.state.log.replication.factor={{ kafka_transaction_state_log_replication_factor }}
transaction.state.log.min.isr={{ kafka_transaction_state_log_min_isr }}

# Tối ưu hóa hiệu năng
num.network.threads={{ kafka_num_network_threads }}
num.io.threads={{ kafka_num_io_threads }}
background.threads={{ kafka_background_threads }}
queued.max.requests={{ kafka_queued_max_requests }}

# Cấu hình log retention
log.retention.hours={{ kafka_log_retention_hours }}
log.retention.bytes={{ kafka_log_retention_bytes }}
log.segment.bytes={{ kafka_log_segment_bytes }}
