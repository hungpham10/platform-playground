# Kafka Legacy configuration for node {{ inventory_hostname }}
# Generated by Ansible

broker.id={{ kafka_node_id }}
listener.security.protocol.map={{ kafka_listener_security_protocol_map }}

listeners={{ kafka_listeners.broker }}{% if kafka_listeners.internal is defined %},{{ kafka_listeners.internal }}{% endif %}{% if kafka_listeners.load_balancer is defined %},{{ kafka_listeners.load_balancer }}{% endif %}

advertised.listeners={{ kafka_advertised_listeners }}{% if kafka_external_advertized_listeners is defined %},{{ kafka_external_advertized_listeners }}{% endif %}

{% if kafka_cluster_certificate is defined %}
{% if kafka_cluster_certificate.external is defined %}
# Cấu hình SSL cho Listener EXTERNAL
listener.name.external.ssl.truststore.location={{ kafka_ssl_dir }}/{{kafka_cluster_certificate.external.truststore.destination }}
listener.name.external.ssl.truststore.password={{ kafka_cluster_certificate.external.truststore.password }}
listener.name.external.ssl.truststore.type={{ kafka_cluster_certificate.external.truststore.type }}

listener.name.external.ssl.keystore.location={{ kafka_ssl_dir }}/{{ kafka_cluster_certificate.keystore.destination }}
listener.name.external.ssl.keystore.password={{ kafka_cluster_certificate.external.keystore.password }}
listener.name.external.ssl.keystore.type={{ kafka_cluster_certificate.external.keystore.type }}

# Chỉ dùng SSL cho client, không bắt client phải có certificate (Client Auth)
listener.name.external.ssl.client.auth=none
{% endif %}

{% if kafka_cluster_certificate.load_balancer is defined %}
{% if kafka_cluster_certificate.load_balancer.truststore is defined %}
# Cấu hình SSL cho Listener LOAD_BALANCER
listener.name.load_balancer.ssl.truststore.location={{ kafka_ssl_dir }}/{{kafka_cluster_certificate.load_balancer.truststore.destination }}
listener.name.load_balancer.ssl.truststore.password={{ kafka_cluster_certificate.load_balancer.truststore.password }}
listener.name.load_balancer.ssl.truststore.type={{ kafka_cluster_certificate.load_balancer.truststore.type }}
{% endif %}

listener.name.load_balancer.ssl.keystore.location={{ kafka_ssl_dir }}/{{ kafka_cluster_certificate.load_balancer.keystore.destination }}
listener.name.load_balancer.ssl.keystore.password={{ kafka_cluster_certificate.load_balancer.keystore.password }}
listener.name.load_balancer.ssl.keystore.type={{ kafka_cluster_certificate.load_balancer.keystore.type }}

# Chỉ dùng SSL cho client, không bắt client phải có certificate (Client Auth)
listener.name.load_balancer.ssl.client.auth=none
{% endif %}
{% endif %}

inter.broker.listener.name={{ kafka_inter_broker_listener_name }}
inter.broker.protocol.version=2.0
log.message.format.version=2.0

zookeeper.connect={{ zookeeper_connects | join(',') }}
zookeeper.connection.timeout.ms=6000

log.dirs={{ kafka_data_dir }}

# Cấu hình topic
num.partitions={{ kafka_num_partitions }}
num.recovery.threads.per.data.dir={{ kafka_num_recovery_thread_per_data }}
auto.create.topics.enable={{ kafka_auto_create_topic }}
replica.fetch.max.bytes={{ kafka_replica_fetch_max }}
message.max.bytes={{ kafka_message_max }}
default.replication.factor={{ kafka_default_replication_factor }}

# Tối ưu hóa hiệu năng
num.network.threads={{ kafka_num_network_threads }}
num.io.threads={{ kafka_num_io_threads }}
queued.max.requests={{ kafka_queued_max_requests }}
socket.send.buffer.bytes={{ kafka_socket_send_buffer }}
socket.receive.buffer.bytes={{ kafka_socket_receive_buffer }}
socket.request.max.bytes={{ kafka_socket_request_max }}

# Cấu hình log retention
log.retention.check.interval.ms={{ kafka_log_retention_check_interval }}
log.retention.hours={{ kafka_log_retention_hours }}
log.retention.bytes={{ kafka_log_retention_bytes }}
log.segment.bytes={{ kafka_log_segment_bytes }}
log.flush.interval.messages={{ kafka_log_flush_interval_messages }}
log.flush.interval.ms={{ kafka_log_flush_interval_ms }}

{% if kafka_sasl_mechanism is defined %}
# SASL chỉ áp dụng cho listener CLIENT
listener.name.external.sasl.enabled.mechanisms={{ kafka_sasl_mechanism.broker }}

{% if kafka_sasl_mechanism.controller is defined %}
# SASL chỉ áp dụng cho listener CONTROLLER
sasl.mechanism.controller.protocol={{ kafka_sasl_mechanism.controller }}
{% endif %}

# SASL connection class và cấu hình
listener.name.external.sasl.enabled.mechanisms={{ kafka_sasl_mechanism.broker }}
{% if kafka_sasl_mechanism.broker == "PLAIN" %}
listener.name.external.{{ kafka_sasl_mechanism.broker | lower }}.sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required \
    username="{{ kafka_admin.user }}" \
    password="{{ kafka_admin.password }}" \
    user_{{ kafka_admin.user }}="{{ kafka_admin.password }}" \
{% for user in (kafka_application | default([])) %}
    user_{{ user.name }}="{{ user.password }}" \
{% endfor %}
    ;
{% else %}
listener.name.external.{{ kafka_sasl_mechanism.broker | lower }}.sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required \
    username="{{ kafka_admin.user }}";
{% endif %}
{% endif %}

{% if kafka_sasl_mechanism.load_balancer is defined %}
listener.name.external.sasl.enabled.mechanisms={{ kafka_sasl_mechanism.load_balancer }}
{% if kafka_sasl_mechanism.load_balancer == "PLAIN" %}
listener.name.external.{{ kafka_sasl_mechanism.load_balancer | lower }}.sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required \
    username="{{ kafka_admin.user }}" \
    password="{{ kafka_admin.password }}" \
    user_{{ kafka_admin.user }}="{{ kafka_admin.password }}" \
{% for user in (kafka_application | default([])) %}
    user_{{ user.name }}="{{ user.password }}" \
{% endfor %}
    ;
{% else %}
listener.name.external.{{ kafka_sasl_mechanism.load_balancer | lower }}.sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required \
    username="{{ kafka_admin.user }}";
{% endif %}
{% endif %}

{% if kafka_sasl_mechanism is defined and kafka_acl_allow_everyone_if_no_acl is defined %}
super.users=User:{{ kafka_admin.user }};User:ANONYMOUS

# Bật ACL Authorizer (cho KRaft)
authorizer.class.name=org.apache.kafka.metadata.authorizer.StandardAuthorizer

# Deny by default: Nếu không có ACL nào match, deny access (an toàn hơn)
allow.everyone.if.no.acl.found={{ kafka_acl_allow_everyone_if_no_acl }}
{% endif %}
