
port {{ redis_port }}
bind {{ redis_bind }}
protected-mode {{ redis_protected_mode }}
timeout 0
tcp-keepalive 300
daemonize yes
pidfile /var/run/redis_{{ redis_port }}.pid
loglevel notice
logfile {{ redis_log_dir }}/redis.log
databases 16

dir {{ redis_data_dir }}
save 900 1
save 300 10
save 60 10000
appendonly yes
appendfilename "appendonly.aof"

{% if redis_requirepass is defined %}
requirepass {{ redis_requirepass }}
{% endif %}
{% if redis_masterauth is defined %}
masterauth {{ redis_masterauth }}
{% endif %}

maxmemory {{ redis_maxmemory }}
maxmemory-policy {{ redis_maxmemory_policy }}

{% if inventory_hostname in groups['replicas'] %}
replicaof {{ hostvars[groups['master'][0]]['ansible_host'] | default(groups['master'][0]) }} {{ redis_port }}
replica-read-only yes
{% endif %}
