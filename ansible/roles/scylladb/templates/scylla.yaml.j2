# Configured by Ansible Scylla role
# Additional parameters can be edited right here for all-node distribution

{% if cluster_name is defined %}
cluster_name: "{{ cluster_name }}"

data_file_directories:
{% for data_path in scylla_data_paths %}
  - {{ data_path }}
{% endfor %}

commitlog_directory: {{ scylla_commit_log_path }}
authenticator: PasswordAuthenticator
authorizer: CassandraAuthorizer

num_tokens: {{ number_of_tokens }}

commitlog_sync: periodic
commitlog_sync_period_in_ms: {{ commit_log_sync_period_in_ms }}
commitlog_segment_size_in_mb: {{ commit_log_segment_size_in_mb }}

seed_provider:
  - class_name: org.apache.cassandra.locator.SimpleSeedProvider
    parameters:
      - seeds: "{{ scylladb_seeds | join(',') }}"

listen_address: {{ ansible_host }}
native_transport_port: 9042

{% if is_running_in_gce %}
endpoint_snitch: GoogleCloudSnitch
{% else %}
endpoint_snitch: GossipingPropertyFileSnitch
{% endif %}

rpc_port: 9160
rpc_address: {{ ansible_host }}

broadcast_address: {{ ansible_host }}
broadcast_rpc_address: {{ ansible_host }}

api_port: 10000
api_address: {{ ansible_host }}

partitioner: org.apache.cassandra.dht.Murmur3Partitioner
murmur3_partitioner_ignore_msb_bits: {{ murmur3_partitioner_ignore_msb_bits }}

batch_size_warn_threshold_in_kb: 5
batch_size_fail_threshold_in_kb: 50

internode_compression: {{ internode_compression }}
auto_snapshot: {{ auto_snapshot }}
{% endif %}



