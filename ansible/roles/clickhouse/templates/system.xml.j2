<?xml version="1.0" ?>
<clickhouse>

    <!-- ===================== PROFILES ===================== -->
    <profiles>
        {% for profile_name, settings in clickhouse_profiles.items() %}
        <{{ profile_name }}>
            {% for key, value in settings.items() %}
            <{{ key }}>{{ value }}</{{ key }}>
            {% endfor %}
        </{{ profile_name }}>
        {% endfor %}

        <!-- Default profile nếu chưa có (bắt buộc phải tồn tại) -->
        {% if 'default' not in clickhouse_profiles %}
        <default>
            <max_threads>8</max_threads>
            <max_memory_usage>10000000000</max_memory_usage>
        </default>
        {% endif %}
    </profiles>

    <!-- ===================== QUOTAS ===================== -->
    <quotas>
        {% for quota_name, quota_data in clickhouse_quotas.items() %}
        <{{ quota_name }}>
            {% if quota_data.intervals is defined %}
            {% for interval in quota_data.intervals %}
            <interval>
                <duration>{{ interval.duration }}</duration>
                {% if interval.queries is defined %}<queries>{{ interval.queries }}</queries>{% endif %}
                {% if interval.errors is defined %}<errors>{{ interval.errors }}</errors>{% endif %}
                {% if interval.result_rows is defined %}<result_rows>{{ interval.result_rows }}</result_rows>{% endif %}
                <!-- Thêm các limit khác nếu cần: read_rows, execution_time, ... -->
            </interval>
            {% endfor %}
            {% endif %}
        </{{ quota_name }}>
        {% endfor %}

        <!-- Quota mặc định nếu chưa có -->
        {% if 'default' not in clickhouse_quotas %}
        <default />
        {% endif %}
    </quotas>

    <!-- ===================== USERS ===================== -->
    <users>
        {% for user in clickhouse_users %}
        <{{ user.name }}>
            <!-- Password -->
            {% if user.password_sha256_hex is defined and user.password_sha256_hex %}
            <password_sha256_hex>{{ user.password_sha256_hex }}</password_sha256_hex>
            {% elif user.password is defined %}
            <password>{{ user.password }}</password>  <!-- plaintext - không khuyến khích -->
            {% endif %}

            <!-- Networks -->
	    {% if (user.networks | default([]) | length) > 0 %}
            <networks incl="networks" replace="replace">
                {% for net in user.networks | default([]) %}
                <{{ net.get('type', 'ip') }}>{{ net.value or net.ip }}</{{ net.get('type', 'ip') }}>
                {% endfor %}
            </networks>
            {% endif %}

            <profile>{{ user.profile | default('default') }}</profile>
            <quota>{{ user.quota | default('default') }}</quota>

            {% if user.readonly is defined %}
	    <readonly>{{ user.readonly }}</readonly>
	    {% endif %}
            {% if user.access_management is defined %}
            <access_management>{{ user.access_management }}</access_management>
            {% endif %}
            {% if user.allow_ddl is defined %}
            <allow_ddl>{{ user.allow_ddl }}</allow_ddl>
            {% endif %}
            {% if user.max_query_size is defined %}
            <max_query_size>{{ user.max_query_size }}</max_query_size>
            {% endif %}
        </{{ user.name }}>
        {% endfor %}

        <!-- Override default nếu cần -->
        {% if clickhouse_manage_user_over_sql_tables | default(false) %}
        <default replace="replace">
            <profile>default</profile>
            <quota>default</quota>
            <no_password />
            <access_management>1</access_management>  <!-- khuyến nghị bật để dùng SQL sau -->
            <networks replace="replace">
                <ip>127.0.0.1</ip>
                <ip>::1</ip>  <!-- IPv6 localhost, rất quan trọng nếu server hỗ trợ IPv6 -->
            </networks>
        </default>
        {% endif %}
    </users>
</clickhouse>
