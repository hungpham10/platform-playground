# Security limits configuration
# Generated by Ansible

# Core file size
* soft core 0
* hard core 0

# Maximum number of open files
* soft nofile 65535
* hard nofile 65535

# Maximum number of processes
* soft nproc 10000
* hard nproc 10000

# Maximum file size
* soft fsize unlimited
* hard fsize unlimited

# Maximum locked memory
* soft memlock 64
* hard memlock 64

# Maximum stack size
* soft stack 8192
* hard stack 8192

# Specific user/group configurations
{% for limit in security_limits | default([]) %}
{{ limit.domain }} {{ limit.type }} {{ limit.item }} {{ limit.value }}
{% endfor %}

# System specific limits
@root soft nofile 65535
@root hard nofile 65535